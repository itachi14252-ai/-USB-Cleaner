# Proyecto solo para Windows: los scripts DEBEN quedar con CRLF al clonar.
# Un .cmd con finales de linea Unix puede fallar al ejecutarse.
* text=auto

*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.json  text eol=crlf
*.md    text eol=crlf

# La version Linux / Omarchy es lo contrario: bash falla con CRLF
# ("$'\r': command not found"). Va despues de las reglas de arriba para
# ganarles, incluido su README.md.
linux/**        text eol=lf
linux/*.svg     text eol=lf

# Binarios: que git no los toque nunca
*.ico   binary
*.png   binary
*.exe   binary
