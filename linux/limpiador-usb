AP_OK=0; AP_FALLO=0
comprobar() {          # comprobar "descripcion" comando...
    local desc=$1; shift
    if "$@" >/dev/null 2>&1; then
        ((AP_OK++)); printf '  %sOK%s     %s\n' "$C_VERDE" "$C_RST" "$desc"
    else
        ((AP_FALLO++)); printf '  %sFALLO%s  %s\n' "$C_ROJO" "$C_RST" "$desc"
    fi
}
bloqueado()     { [[ -n $(razones_bloqueo "$1") ]]; }
operable()      { [[ -z $(razones_bloqueo "$1") ]]; }
