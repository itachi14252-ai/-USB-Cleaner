VER_TODOS=0

discos_visibles() {    # extraibles; con VER_TODOS tambien los internos
    local d
    for d in "${DISCOS[@]}"; do
        (( VER_TODOS )) || bus_extraible "$d" || continue
        printf '%s\n' "$d"
    done
}

menu_disco() {
    local d=$1 op p rz nucleo
    local -a ops
    while true; do
        leer_discos; cargar_preferencias
        [[ -n ${D_TAM[$d]:-} ]] || { ui_error "/dev/$d ya no esta conectado."; ui_pausa; return; }
        ui_banner
        mostrar_tarjeta "$d"
        rz=$(razones_bloqueo "$d"); nucleo=$(razones_bloqueo "$d" nucleo)
        ops=()
        if [[ -z $rz ]]; then
            for p in ${D_PARTES[$d]:-}; do
                [[ -n ${P_FSTYPE[$p]:-} ]] && ops+=("LIMPIAR     /dev/$p  ${P_ETIQ[$p]:-}")
            done
            for p in ${D_PARTES[$d]:-}; do ops+=("FORMATEAR   /dev/$p"); done
            ops+=("REPARAR     disco completo: tabla nueva + formato"
                  "GRABAR      imagen .iso / .img byte a byte")
        fi
        [[ -z $nucleo ]] && ops+=("EXPULSAR")
        # Solo lectura: tambien en discos blindados, que es donde mas importa.
        ops+=("DIAGNOSTICO" "RECUPERAR   archivos borrados o formateados")
        [[ -z $nucleo ]] && ops+=("PROTECCION  proteger / eximir este disco")
        ops+=("VOLVER")
        op=$(ui_elegir "/dev/$d  -  que hacer" "${ops[@]}") || return
        case $op in
            LIMPIAR*)     p=$(awk '{print $2}' <<< "$op"); op_limpiar "${p#/dev/}" ;;
            FORMATEAR*)   p=$(awk '{print $2}' <<< "$op"); op_formatear "${p#/dev/}" ;;
            REPARAR*)     op_reparar "$d" ;;
            GRABAR*)      op_grabar "$d" ;;
            EXPULSAR*)    op_expulsar "$d" && { ui_pausa; return; } ;;
            DIAGNOSTICO*) op_diagnostico "$d"; continue ;;
            RECUPERAR*)   op_recuperar "$d" ;;
            PROTECCION*)  op_proteccion "$d" ;;
            *)            return ;;
        esac
        ui_pausa
    done
}

menu_principal() {
    local op d hay_blindada
    local -a ids lineas bl libres
    trap 'printf "\n"' INT     # Ctrl+C corta la operacion en curso, no el programa
    while true; do
        reiniciar_reglas; cargar_config; cargar_preferencias; leer_discos
        ui_banner
        mapfile -t ids < <(discos_visibles)
        bl=(); libres=(); hay_blindada=0
        # Las blindadas primero, como en Windows.
        for d in "${ids[@]}"; do
            if [[ -n $(razones_bloqueo "$d") ]]; then bl+=("$d")
                [[ -z $(razones_bloqueo "$d" nucleo) ]] && hay_blindada=1
            else libres+=("$d"); fi
        done
        (( hay_blindada )) && printf '  %s/// UNIDAD BLINDADA CONECTADA ///%s\n' "$C_ROJO" "$C_RST"
        lineas=()
        for d in "${bl[@]}" "${libres[@]}"; do lineas+=("$(linea_disco "$d")"); done
        (( ${#lineas[@]} )) || ui_info "  No hay memorias USB ni tarjetas conectadas."
        if (( VER_TODOS )); then lineas+=("·· SOLO MEDIOS EXTRAIBLES")
        else lineas+=("·· VER TODOS LOS DISCOS (internos: solo diagnostico)"); fi
        lineas+=("·· ACTUALIZAR" "·· AUTOPRUEBA DEL GUARDIAN" "·· REGISTRO" "·· SALIR")
        op=$(ui_elegir "Unidades  (serie = identidad, no /dev/sdX)" "${lineas[@]}") || exit 0
        case $op in
            "·· VER TODOS"*)  VER_TODOS=1 ;;
            "·· SOLO"*)       VER_TODOS=0 ;;
            "·· ACTUALIZAR")  ;;
            "·· AUTOPRUEBA"*) autoprueba; ui_pausa ;;
            "·· REGISTRO")    ui_titulo "REGISTRO ($LOG_FILE)"
                              tail -n 40 -- "$LOG_FILE" 2>/dev/null || ui_info "  (vacio)"; ui_pausa ;;
            "·· SALIR")       exit 0 ;;
            *)                menu_disco "${op%% *}" ;;
        esac
    done
}

# Desde el lanzador de Omarchy no hay terminal: se abre una.
abrir_en_terminal() {
    [[ -t 0 && -t 1 ]] && return 0
    local t
    command -v xdg-terminal-exec >/dev/null 2>&1 && exec xdg-terminal-exec bash "$SELF"
    for t in "${TERMINAL:-}" alacritty ghostty kitty foot wezterm konsole gnome-terminal xterm; do
        [[ -n $t ]] && command -v "$t" >/dev/null 2>&1 || continue
        case $t in
            gnome-terminal) exec "$t" -- bash "$SELF" ;;
            wezterm)        exec "$t" start -- bash "$SELF" ;;
            *)              exec "$t" -e bash "$SELF" ;;
        esac
    done
    command -v notify-send >/dev/null 2>&1 && notify-send "Limpiador de USB" "No encontre una terminal para abrirlo."
    exit 1
}

ayuda() {
    cat <<EOF
Limpiador de USB $VERSION - version Linux / Omarchy

  limpiador-usb              abre el menu
  limpiador-usb --ventana    igual, pero abre una terminal si hace falta (lanzador)
  limpiador-usb --autoprueba comprueba el guardian sin tocar ningun disco
  limpiador-usb --version

Configuracion:  $CONF_FILE
Preferencias:   $PREF_FILE
Registro:       $LOG_FILE
EOF
}

main() {
    case ${1:-} in
        --interno)
            # Solo lo invoca el propio programa via sudo, y solo lee.
            (( EUID == 0 )) || { echo "--interno es de uso interno (via sudo)" >&2; exit 1; }
            [[ ${3:-} == /dev/* && -b ${3:-} ]] || exit 2
            case ${2:-} in
                acceso)
                    [[ ${4:-} =~ ^[0-9]+$ ]] || exit 2
                    interno_acceso "$3" "$4" ;;
                superficie)
                    [[ ${4:-} =~ ^[0-9]+$ && ${5:-} =~ ^[0-9]+$ && ${6:-} =~ ^[0-9]+$ \
                       && ${7:-} =~ ^[0-9]+$ && ${8:-} =~ ^(muestreo|completo)$ ]] || exit 2
                    interno_superficie "$3" "$4" "$5" "$6" "$7" "$8" ;;
                *) exit 2 ;;
            esac
            exit ;;
        --autoprueba) autoprueba; exit $? ;;
        --version)    echo "$VERSION"; exit 0 ;;
        -h|--help)    ayuda; exit 0 ;;
        --ventana)    abrir_en_terminal ;;
        "") ;;
        *) ayuda; exit 2 ;;
    esac
    [[ $(uname -s) == Linux ]] || { echo "Esta es la version para Linux. En Windows usa Limpiador-USB.ps1." >&2; exit 1; }
    for c in lsblk findmnt; do
        command -v "$c" >/dev/null 2>&1 || { echo "Falta $c (paquete util-linux)." >&2; exit 1; }
    done
    menu_principal
}

