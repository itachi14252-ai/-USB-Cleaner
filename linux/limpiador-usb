autoprueba() (
    # Subshell: nada de lo que se simula aqui sale afuera.
    local tmp f u1 u8 d
    AP_OK=0; AP_FALLO=0
    tmp=$(mktemp -d) || exit 1
    trap 'rm -rf -- "$tmp"' EXIT
    CONF_FILE="$tmp/config.conf"; PREF_FILE="$tmp/preferencias"; LOG_FILE="$tmp/registro.log"

    printf '\n  %s/// AUTOPRUEBA DEL GUARDIAN ///%s   (discos simulados, no se toca nada)\n' "$C_ORO" "$C_RST"

    ui_titulo "lectura de lsblk"
    ap_cargar
    comprobar "10 discos reales; se ignoran loop, DVD y el lector sin tarjeta" igual "${#DISCOS[@]}" 10
    comprobar "etiqueta con espacio y comillas escapadas: MIS \"FOTOS\""       igual "${P_ETIQ[sdb1]}" 'MIS "FOTOS"'
    comprobar "punto de montaje con espacio decodificado"                    igual "${P_MONT[sdb1]}" '/run/media/u/MIS FOTOS'
    comprobar "modelo sin espacios de relleno"                               igual "${D_MODELO[sdc]}" 'Expansion HDD'
    comprobar "memoria sin tabla de particiones: el disco hace de particion"  igual "$(recortar "${D_PARTES[sdh]}")" sdh
    comprobar "la raiz cifrada (LUKS) se resuelve hasta el NVMe"              igual "$(discos_bajo mapper/root)" nvme0n1

    ui_titulo "nivel 1 - nucleo"
    comprobar "disco del sistema: raiz / a traves de LUKS + btrfs"           razon_incluye nvme0n1 "DISCO DEL SISTEMA OPERATIVO (/)"
    comprobar "disco del sistema: tambien arranque (/boot)"                  razon_incluye nvme0n1 "DISCO DE ARRANQUE (/boot)"
    comprobar "subvolumen btrfs [/@home] resuelto al mismo disco"            razon_incluye nvme0n1 "ALOJA /home"
    comprobar "NVMe interno: solo diagnostico"                               razon_incluye nvme0n1 "SOLO DIAGNOSTICO"
    comprobar "la memoria desde la que corre el programa queda intocable"    es_nucleo sdf
    comprobar "memoria con volumen LUKS abierto encima: bloqueada"           razon_incluye sdg "ABIERTO ENCIMA"
    comprobar "bus desconocido: se asume lo peor"                            razon_incluye sda "BUS DESCONOCIDO"
    comprobar "tarjeta SD (mmcblk) sin transporte declarado: permitida"      operable mmcblk0
    cambiar_proteccion SERIE-SISTEMA eximir; ap_cargar
    comprobar "EXIMIR el disco del sistema no levanta el nucleo"             es_nucleo nvme0n1
    comprobar "  ... y su estado sigue siendo 'nucleo'"                      igual "$(estado_proteccion nvme0n1)" nucleo
    rm -f -- "$PREF_FILE"

    ui_titulo "nivel 2 - heuristicas"
    ap_cargar
    comprobar "Seagate 4 TB: bloqueado por varias reglas a la vez"           al_menos sdc 2
    comprobar "  ... incluye el modelo"                                      razon_incluye sdc "MODELO CONTIENE 'SEAGATE'"
    comprobar "  ... e incluye el tamano"                                    razon_incluye sdc "EXCEDE EL LIMITE DE 2048 GB"
    comprobar "memoria SanDisk de 16 GB: permitida"                          operable sdb
    comprobar "HDD de 1 TB en carcasa JMicron (como el H:): permitido"       operable sdd
    cambiar_proteccion NA8XYZ12 eximir; ap_cargar
    comprobar "EXIMIR el Seagate lo libera (modelo y tamano)"                operable sdc
    cambiar_proteccion NA8XYZ12 reactivar; ap_cargar
    comprobar "REACTIVAR lo vuelve a bloquear"                               bloqueado sdc
    cambiar_proteccion NA8 eximir; ap_cargar
    comprobar "una exencion corta ('NA8') NO libera series que la contengan" bloqueado sdc
    rm -f -- "$PREF_FILE"
    ap_cargar "seriales = NA8XYZ12" "permitidos = NA8XYZ12"
    comprobar "serie en lista negra Y en permitidos: gana la lista negra"    razon_incluye sdc "NUMERO DE SERIE BLINDADO"
    ap_cargar "etiquetas = respaldo"
    comprobar "etiqueta agregada en config.conf"                             razon_incluye sdc "ETIQUETA BLINDADA 'RESPALDO'"
    ap_cargar "tam_max_gb = 900"
    comprobar "tam_max_gb = 900 lo baja: el HDD de 1 TB queda bloqueado"     bloqueado sdd
    ap_cargar "tam_max_gb = 4096"
    comprobar "tam_max_gb = 4096 se ignora: solo se puede bajar"             igual "$G_TAM_MAX_GB" 2048
    ap_cargar "tam_max_gb = 0900"
    comprobar "tam_max_gb = 0900 se lee en decimal, no en octal"             igual "$G_TAM_MAX_GB" 900
    ap_cargar "seriales = \$(touch $tmp/INYECTADO)" "modelos = \`touch $tmp/INYECTADO2\`"
    comprobar "config.conf se lee, no se ejecuta: \$(...) no corre"          test ! -e "$tmp/INYECTADO" -a ! -e "$tmp/INYECTADO2"
    printf 'esto no es una config\x00\xff\n= = =\nseriales\n' > "$CONF_FILE"
    reiniciar_reglas; cargar_config; limpiar_datos; procesar_lsblk <<< "$AP_FIXTURE"
    comprobar "config.conf corrupto: el programa sigue igual de protegido"   bloqueado sdc

    ui_titulo "nivel 3 - lo que decides tu"
    rm -f -- "$PREF_FILE"; ap_cargar
    cambiar_proteccion USB-PRUEBA-1 proteger; ap_cargar
    comprobar "memoria libre -> PROTEGER -> bloqueada"                       razon_incluye sdb "PROTEGIDO POR TI"
    comprobar "la proteccion sobrevive a releer el archivo"                  grep -q $'^protegido\tUSB-PRUEBA-1$' "$PREF_FILE"
    cambiar_proteccion USB-PRUEBA-1 desproteger; ap_cargar
    comprobar "DESPROTEGER la devuelve a operable"                           operable sdb
    cambiar_proteccion NA8XYZ12 eximir; cambiar_proteccion NA8XYZ12 proteger; ap_cargar
    comprobar "PROTEGER gana sobre EXIMIR"                                   razon_incluye sdc "PROTEGIDO POR TI"
    comprobar "disco sin serie: no se puede recordar"                        test "$(cambiar_proteccion '' proteger 2>/dev/null; echo $?)" = 1
    comprobar "  ... y su tarjeta lo dice"                                   igual "$(estado_proteccion sde)" sinserie
    printf 'basura\x00\nprotegido\n\texento\n' > "$PREF_FILE"; ap_cargar
    comprobar "preferencias corruptas: nada se libera"                       bloqueado sdc

    ui_titulo "identidad y rutas"
    rm -f -- "$PREF_FILE"; ap_cargar
    comprobar "disco que desaparece entre la tarjeta y la escritura: aborta" \
        eval '! verificar_antes_de_escribir sdz "x|1|y|z"'
    comprobar "huella: serie + tamano + modelo + WWN"                        igual "$(huella_guardada sdd)" "123467|1000204886016|Tech|"
    fuente_de_montaje() { echo /dev/sdb1; }
    comprobar "LIMPIAR se niega con una ruta vacia"                          eval '! ruta_limpiable sdb1 ""'
    comprobar "LIMPIAR se niega con la raiz /"                               eval '! ruta_limpiable sdb1 /'
    comprobar "LIMPIAR se niega si el montaje es de otra particion"          eval '! ruta_limpiable sdc1 "$tmp"'
    comprobar "particiones: sdb->sdb1, mmcblk0->mmcblk0p1, nvme0n1->nvme0n1p1" \
        test "$(nombre_particion sdb 1) $(nombre_particion mmcblk0 1) $(nombre_particion nvme0n1 1)" = "/dev/sdb1 /dev/mmcblk0p1 /dev/nvme0n1p1"

    ui_titulo "formatos, imagenes y diagnostico"
    comprobar "16 GB -> FAT32, 64 GB -> exFAT"                               test "$(fs_automatico 16008609792) $(fs_automatico 64023257088)" = "vfat exfat"
    comprobar "etiqueta FAT32: mayusculas, sin simbolos, 11 caracteres"      igual "$(etiqueta_valida vfat 'mis fotos 2024!')" "MIS FOTOS 2"
    comprobar "etiqueta vacia -> USB"                                        igual "$(etiqueta_valida exfat '')" USB
    comprobar "hash: 32 MD5, 40 SHA1, 64 SHA256, otro nada" \
        test "$(algoritmo_hash "$(printf '%032d' 0)") $(algoritmo_hash "$(printf '%040d' 0)") $(algoritmo_hash "$(printf '%064d' 0)") $(algoritmo_hash abc || echo no)" = "md5sum sha1sum sha256sum no"
    f="$tmp/linux.img"; { head -c 510 /dev/zero; printf '\x55\xaa'; } > "$f"
    comprobar "imagen con firma 0x55AA: arrancable"                          igual "$(firma_arranque "$f")" 55aa
    f="$tmp/windows.iso"; head -c 512 /dev/zero > "$f"
    comprobar "imagen sin firma (ISO de Windows): se detecta para avisar"    test "$(firma_arranque "$f")" != 55aa
    comprobar "acceso 0.3 ms -> electronico"                                 contiene "$(veredicto_acceso 0.3)" ELECTRONICO
    comprobar "acceso 5 ms -> no concluyente"                                contiene "$(veredicto_acceso 5)" "NO CONCLUYENTE"
    comprobar "acceso 12 ms -> mecanico"                                     contiene "$(veredicto_acceso 12)" MECANICO
    u1=$(umbrales 1048576); u8=$(umbrales 8388608)
    for d in 23 120 2000; do
        comprobar "disco a $d MB/s: misma franja con bloque de 1 MB y de 8 MB" \
            test "$(franja "$(LC_ALL=C awk -v v="$d" 'BEGIN{print 1000/v}')" "$u1")" = \
                 "$(franja "$(LC_ALL=C awk -v v="$d" 'BEGIN{print 8000/v}')" "$u8")"
    done

    ui_titulo "estructura del programa"
    for f in op_limpiar op_formatear op_reparar op_grabar; do
        comprobar "$f vuelve a pasar el guardian justo antes de escribir" \
            eval "declare -f $f | grep -q verificar_antes_de_escribir"
    done
    comprobar "las ordenes destructivas solo viven en funciones permitidas" ap_destructivas_contenidas

    printf '\n  %s%d comprobaciones, %d fallos%s\n' \
        "$([[ $AP_FALLO -eq 0 ]] && printf '%s' "$C_VERDE" || printf '%s' "$C_ROJO")" \
        "$((AP_OK + AP_FALLO))" "$AP_FALLO" "$C_RST"
    (( AP_FALLO == 0 ))
)

# Ninguna funcion fuera de esta lista puede contener wipefs, sfdisk,
# mkfs, rm -rf o un dd que escriba en /dev: si alguien agrega una, la
# autoprueba lo delata.
ap_destructivas_contenidas() {
    local fn permitidas=" op_limpiar op_reparar op_grabar crear_fs op_formatear op_expulsar "
    for fn in $(declare -F | awk '{print $3}'); do
        [[ $fn == ap_* || $fn == autoprueba ]] && continue
        if declare -f "$fn" | grep -qE 'wipefs -a|sfdisk --|mkfs\.[a-z0-9]+ -|rm -rf|dd (if=[^ ]+ )?of="/dev/|/device/delete'; then
            [[ $permitidas == *" $fn "* ]] || { echo "destructiva fuera de lugar: $fn"; return 1; }
        fi
    done
}

